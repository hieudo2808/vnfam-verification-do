{
    "$schema": "../node_modules/wrangler/config-schema.json",
    "name": "vnfam-cms-staging",
    "main": "worker.ts",
    "account_id": "e3751cca6cbf061906dbf691456c8dd8",
    "compatibility_date": "2026-11-04",
    "compatibility_flags": ["nodejs_compat"],
    "workers_dev": false,
    "preview_urls": false,
    "routes": [{ "pattern": "cms-staging.castorice.tech", "custom_domain": true }],
    "assets": {
        "directory": "../dist-cms",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/cms-api", "/cms-api/*"],
    },
    "services": [{ "binding": "DEVICE_API", "service": "vnfam-device-api-staging" }],
    // shortcut: public staging authorized for testing; add an access gate before using real data/devices.
    "vars": {
        "CMS_ACTOR_ID": "staging_operator",
        "CMS_ACTOR_NAME": "Quản trị viên thử nghiệm",
        "CMS_ORIGIN": "https://cms-staging.castorice.tech",
        "CMS_MODE": "public-test",
        "CMS_SITE_ID": "staging_site",
        "CMS_SCOPE_ID": "staging_scope",
    },
    "observability": {
        "enabled": true,
        "redact_query_string": true,
        "traces": { "enabled": true },
    },
}
