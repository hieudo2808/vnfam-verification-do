{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022"],
        "types": ["node"],
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noEmit": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "paths": { "@/*": ["./cms/src/*"] }
    },
    "include": ["src/**/*.ts", "worker-configuration.d.ts"]
}
